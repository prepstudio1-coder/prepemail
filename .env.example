# ─── Legal Pages ─────────────────────────────────────────────────────────────
# Public-facing policy pages — no secrets, listed here for discoverability.
# Privacy Policy: /privacy.html
# Terms of Use:   /terms.html

# ─── Firebase Configuration ───────────────────────────────────────────────────
# Get these values from Firebase Console → Project Settings → General
# Firebase client-side keys are intentionally public; security comes from Firestore Rules.
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ─── Firebase Admin SDK ────────────────────────────────────────────────────────
# Server-side only. Get from Firebase Console → Project Settings → Service Accounts
# → Generate new private key. Paste the entire JSON as a single-line string.
# NEVER commit the real value. Store it in your hosting provider's secret manager.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id",...}

# FIREBASE_API_KEY is also used server-side as a fallback for password reset when
# FIREBASE_SERVICE_ACCOUNT_JSON is not set. It is the same key as the client-side
# key above and is safe to expose. Add it to Render environment variables as well.
# (Same value as FIREBASE_API_KEY above — no need to set it twice in development)
# ─── Server Configuration ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ─── Paystack Payment ────────────────────────────────────────────────────────
# Get keys from https://dashboard.paystack.com/#/settings/developer
# Use TEST keys (sk_test_... / pk_test_...) for development, LIVE keys for production.
# The SECRET key is server-side only. The PUBLIC key is safe to expose client-side.
PAYSTACK_SECRET_KEY=sk_live_your_live_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_live_public_key_here
# Note: Paystack webhook signature uses PAYSTACK_SECRET_KEY directly (HMAC-SHA512).
# No separate webhook secret is needed — just set the webhook URL in your Paystack dashboard.
# ─── Frontend Backend URL / Local Dev ─────────────────────────────────────────
# If your frontend is served separately from the backend in local development,
# use one of these to point the client to the local Node backend.
# Set VITE_USE_LOCAL_BACKEND=true to use http://localhost:3000 automatically.
# VITE_USE_LOCAL_BACKEND=true
# Or specify the backend host explicitly.
# VITE_API_BASE_URL=http://localhost:3000
# ─── Brevo (Email) ────────────────────────────────────────────────────────────
# Get from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# ─── AI Services ──────────────────────────────────────────────────────────────
# Hugging Face token — server-side only, never expose in client code
HF_TOKEN=hf_your_hugging_face_token_here

# Google Gemini API key — server-side only
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API key — server-side only fallback when Gemini is rate-limited
# Get a free key at https://openrouter.ai — no credit card required
# Free models (ending in :free) work with a $0 balance
OPENROUTER_API_KEY=your_openrouter_api_key_here

# TMDB API key — server-side only
# Get a free API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
