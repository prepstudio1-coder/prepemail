{
  "name": "prep-workspace",
  "version": "1.0.0",
  "description": "PREP Workspace - Cinematic Pre-production Operating System",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "pdf": "node make-pdf.js",
    "pdf:mobile": "node make-pdf-mobile.js",
    "electron": "electron .",
    "electron-dev": "electron .",
    "test": "jest --passWithNoTests",
    "test:e2e": "cypress run",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "7.4.1",
    "firebase-admin": "^12.7.0",
    "jspdf": "^2.5.2",
    "node-fetch": "^2.7.0",
    "puppeteer": "25.0.4"
  },
  "devDependencies": {
    "cypress": "^13.10.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "keywords": [
    "film",
    "pre-production",
    "screenplay",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
